import random
from datetime import datetime

import pandas as pd
import plotly.graph_objects as go
import streamlit as st

from Logic import alarms, motors, ovens, sensors

try:
    from modbus_client import FactoryPLC
except ImportError:  # pragma: no cover - allows the app to run in demo mode without Modbus
    FactoryPLC = None

st.set_page_config(
    page_title="BIASHARA MASTERS IMPREGNATION LINE MONITOR",
    layout="wide",
)

st.markdown(
    """
    <style>
    .stApp{background:#f5f7fa;}
    h1, h2, h3{color:#0d47a1 !important; font-family: monospace;}
    div[data-testid="stMetric"]{background:white; border-radius:12px; border-left:4px solid #0d47a1; box-shadow: 0 2px 8px rgba(0,0,0,0.06);}
    </style>
    """,
    unsafe_allow_html=True,
)

if "ticks" not in st.session_state:
    st.session_state.ticks = pd.DataFrame()

# --- HEADER ---
st.markdown("BIASHARA MASTERS SAWMILL")

REAL_PLC = FactoryPLC is not None

if REAL_PLC:
    try:
        plc = FactoryPLC()
        if not plc.connect():
            raise RuntimeError("PLC connection failed")
        raw = plc.read_all()
        plc.close()
        if raw.get("Error"):
            raise RuntimeError(raw["Error"])
    except Exception:
        REAL_PLC = False
        raw = {
            "coils": [True] * 8,
            "descrete": [True] * 8,
            "holding": [0] * 30,
            "input_regs": [0] * 10,
        }
else:
    raw = {
        "coils": [True, True, True, True, False, False, False, False],
        "descrete": [random.choice([True, False]), True, True, False],
        "holding": [145 + random.uniform(-2, 2) for _ in range(6)] + [0] * 4 + [22, 22, 35],
        "input_regs": [320, 85],
    }

st.caption(
    f"SERVER 192.168.1.88:502 | {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} EAT | {'LIVE' if REAL_PLC else 'SIMULATION'}"
)

# Pull logic modules
oven_data = ovens.process_ovens(raw.get("holding", []))
motor_data = motors.process_motors(raw.get("coils", []), raw.get("holding", []))
sensor_data = sensors.process_sensors(raw.get("descrete", []), raw.get("input_regs", []))
alert_list = alarms.evaluate_alarms(oven_data, motor_data, sensor_data)

# Display the data
cols = st.columns(3)
for i in range(6):
    oven = oven_data[f"oven{i + 1}"]
    col = cols[i % 3]
    col.metric(
        f"Oven-{i + 1} {oven['status']}",
        f"{oven['actual']} Celcius",
        f"{oven['delta']:+.1f} Celcius vs {oven['setpoint']} Celcius",
    )

new_row = {
    "time": datetime.now(),
    **{f"oven{i + 1}": oven_data[f"oven{i + 1}"]["actual"] for i in range(6)},
}

st.session_state.ticks = pd.concat(
    [st.session_state.ticks, pd.DataFrame([new_row])],
    ignore_index=True,
)
if len(st.session_state.ticks) > 200:
    st.session_state.ticks = st.session_state.ticks.tail(200)

fig = go.Figure()
colors = [
    "#0d47a1",
    "#1976d2",
    "#ef6c00",
    "#6a1b9a",
    "#c62828",
    "#f9a825",
]

for i in range(6):
    fig.add_trace(
        go.Scatter(
            x=st.session_state.ticks["time"],
            y=st.session_state.ticks[f"oven{i + 1}"],
            name=f"OVEN-{i + 1}",
            line={"color": colors[i]},
        )
    )

fig.update_layout(template="plotly_white", height=380, title="TEMPERATURE TREND. LAST 60 MINUTES.")
st.plotly_chart(fig, use_container_width=True)

c1, c2 = st.columns([2, 1])
with c2:
    st.markdown("### SYSTEM STATE")
    st.write(f"FEED RATE: {sensor_data.get('resin_weight', 0)} kg/hr")
    st.write(f"MAIN DRIVE: {'RUNNING' if motor_data.get('main_drive', {}).get('run') else 'STOPPED'}")
    st.write(f"E-STOP OK: {sensor_data.get('e_stop_ok')}")
    st.markdown("### ALERTS")
    for alert in alert_list:
        if alert["level"] == "CRIT":
            st.error(alert["msg"])
        else:
            st.warning(alert["msg"])

st.markdown("BIASHARA MASTERS CONTROL v1.0.0 | PLC CONNECTED | SECURE SESSION | a product of KUTSWAINC.")
